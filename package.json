{
  "name": "tayyar-download-manager",
  "productName": "Tayyar",
  "version": "1.0.20",
  "author": {
    "name": "Mu'men Mahbuobeh",
    "email": "mumenmahbuobeh@users.noreply.github.com"
  },
  "description": "Tayyar — Next-Generation Open Source Multi-Connection Download Manager",
  "homepage": "https://github.com/mumenmahbuobeh/tayyar",
  "repository": {
    "type": "git",
    "url": "https://github.com/mumenmahbuobeh/tayyar.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/engine.test.js",
    "pack:ext": "node -e \"const fs=require('fs'),arch=require('archiver'); fs.mkdirSync('dist',{recursive:true}); ['extension','extension-firefox'].forEach(f=>{ const n=f==='extension'?'Chrome':'Firefox'; const o=fs.createWriteStream('dist/Tayyar-'+n+'-Extension-v'+require('./package.json').version+'.zip'); const a=arch('zip',{zlib:{level:9}}); a.pipe(o); a.directory(f,false); a.finalize(); });\"",
    "dist": "npm run pack:ext && electron-builder",
    "dist:win": "npm run pack:ext && electron-builder --win",
    "dist:linux": "npm run pack:ext && electron-builder --linux",
    "dist:mac": "npm run pack:ext && electron-builder --mac",
    "build:android": "node -e \"if (!require('fs').existsSync('mobile/capacitor.js')) require('fs').copyFileSync('node_modules/@capacitor/core/dist/capacitor.js', 'mobile/capacitor.js')\" && npx cap copy android && npx cap sync android",
    "open:android": "npx cap open android",
    "build:ios": "node -e \"if (!require('fs').existsSync('mobile/capacitor.js')) require('fs').copyFileSync('node_modules/@capacitor/core/dist/capacitor.js', 'mobile/capacitor.js')\" && npx cap copy ios && npx cap sync ios",
    "open:ios": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mahbuobeh.tayyar",
    "productName": "Tayyar",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**",
      "renderer/**",
      "extension/**",
      "extension-firefox/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "linux": {
      "maintainer": "Mu'men Mahbuobeh <mumenmahbuobeh@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    },
    "appImage": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "deb": {
      "artifactName": "tayyar_${version}_amd64.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "rahad-all-downloader-v2": "^2.19.0"
  }
}
