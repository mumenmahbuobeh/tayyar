{
  "name": "tayyar-download-manager",
  "productName": "Tayyar",
  "version": "1.0.0",
  "author": "Mu'men Mahbuobeh",
  "description": "Tayyar — Next-Generation Open Source Multi-Connection Download Manager",
  "homepage": "https://github.com/mumenmahbuobeh/tayyar",
  "repository": {
    "type": "git",
    "url": "https://github.com/mumenmahbuobeh/tayyar.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/engine.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "build:android": "npx cap copy android && npx cap sync android",
    "open:android": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mahbuobeh.tayyar",
    "productName": "Tayyar",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**",
      "renderer/**",
      "extension/**",
      "extension-firefox/**",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  }
}
