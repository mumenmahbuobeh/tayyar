{
  "name": "tayyar-download-manager",
  "productName": "Tayyar",
  "version": "1.0.0",
  "author": "Mu'men Mahbuobeh",
  "description": "تيّار — مدير تحميلات حديث متعدد الاتصالات مفتوح المصدر | Modern Open Source Download Manager",
  "homepage": "https://github.com/mumenmahbuobeh/tayyar",
  "repository": {
    "type": "git",
    "url": "https://github.com/mumenmahbuobeh/tayyar.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/engine.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mahbuobeh.tayyar",
    "productName": "Tayyar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "renderer/**",
      "extension/**",
      "extension-firefox/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  }
}
