{
  "manifest_version": 3,
  "name": "Tayyar Download Manager Integration — تيّار",
  "short_name": "Tayyar",
  "version": "1.0.22",
  "description": "Send downloads, media files, and links directly from Firefox to the Tayyar multi-connection desktop download manager.",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "webRequest",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:6824/*",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tayyar-extension@mahbuobeh.com",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tayyar Download Manager",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}